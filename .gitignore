# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.venv/
venv/

# Testing / tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Pipeline output. Anchored to the root on purpose: an unanchored runs/ also
# matches configs/runs/, which silently kept the shipped run configs untracked.
/runs/
*.parquet

# Third-party browser bundle, fetched by cyclicnano.webui.fetch_vendor. Half a
# megabyte of minified JavaScript does not belong in a research repository, and
# the page falls back to a CDN when it is absent.
src/cyclicnano/webui/static/vendor/

# Model weights and databases (never committed)
weights/
params/
*.pt
*.pkl
*.npz

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
